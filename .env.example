# Example environment variables. Copy to .env.local and fill in real values.
# NEVER commit .env.local or real secrets. Keep this file in sync with
# docs/CONFIGURATION.md: every variable here is documented there, and vice versa.

# --- Application ---
# Canonical origin, no trailing slash (public)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Error tracking (example: Sentry) ---
# Server DSN
SENTRY_DSN=
# Browser DSN (public)
NEXT_PUBLIC_SENTRY_DSN=
# development | preview | production
SENTRY_ENVIRONMENT=development
# Source map upload token (build-time secret)
SENTRY_AUTH_TOKEN=
# Fraction of transactions to trace (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Example third-party service ---
# Server-only secret
EXAMPLE_API_KEY=
