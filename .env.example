# Example environment variables. Copy to .env.local and fill in real values.
# NEVER commit .env.local or real secrets. Keep this file in sync with
# docs/CONFIGURATION.md: every variable here is documented there, and vice versa.

# --- Application ---
# Canonical origin, no trailing slash (public). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Photo counting (SPEC-0001; off by default) ---
# "true" turns it on. Anything else, or unset, keeps it off and hidden.
# Read SPEC-0001 §7 before enabling in production.
PHOTO_COUNT_ENABLED=false
# OpenAI-compatible API base URL. Defaults to https://openrouter.ai/api/v1.
PHOTO_COUNT_API_BASE_URL=
# Server-only secret from the provider's dashboard. Required when enabled.
PHOTO_COUNT_API_KEY=
# Vision-capable model id at that provider. Required when enabled.
PHOTO_COUNT_MODEL=
